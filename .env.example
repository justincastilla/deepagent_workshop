# =============================================================================
# DevRel-DeepAgent JS Workshop — environment template
# =============================================================================
# Copy this to .env and paste in the values your instructor gave you.
# All values are workshop-provided; you don't need any of your own API keys.

# -----------------------------------------------------------------------------
# LLM access (workshop-provided LiteLLM proxy)
# -----------------------------------------------------------------------------
# A virtual key issued just for you. Has a budget cap.
LITELLM_API_KEY=

# Base URL of the workshop LiteLLM proxy. Same for everyone.
LITELLM_API_BASE=

# Model alias configured on the proxy. Don't change unless your instructor
# tells you to. The "llm-gateway/" prefix is just a namespace.
LLM_MODEL=llm-gateway/claude-sonnet-4-5

# -----------------------------------------------------------------------------
# Elasticsearch sandbox (workshop-provided, read-only)
# -----------------------------------------------------------------------------
ELASTICSEARCH_HOST=
ELASTICSEARCH_API_KEY=

# Kibana Agent Builder — this is what the elastic subagent talks to.
KIBANA_URL=
ELASTIC_AGENT_ID=

# -----------------------------------------------------------------------------
# Other tools used by non-elastic subagents (workshop-provided)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=
GITHUB_API_KEY=

# -----------------------------------------------------------------------------
# App config
# -----------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
